# Copy to .env and adjust
DATABASE_URL=postgres://postgres:postgres@localhost:5432/itpm360
PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000

# Email notifications (optional). Without SMTP_URL, notifications are captured
# in memory (dev/test). Set SMTP_URL to deliver via SMTP; EMAIL_ENABLED=off
# disables email entirely.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=ITPM360 <no-reply@yourco.com>
# EMAIL_ENABLED=on
